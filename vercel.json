{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)",          "dest": "backend/server.js" },
    { "src": "/socket.io/(.*)",    "dest": "backend/server.js" },
    { "src": "/api-docs(.*)",      "dest": "backend/server.js" },
    { "src": "/login",             "dest": "backend/server.js" },
    { "src": "/app",               "dest": "backend/server.js" },
    { "src": "/contact\\.html",    "dest": "backend/server.js" },
    { "src": "/privacy\\.html",    "dest": "backend/server.js" },
    { "src": "/terms\\.html",      "dest": "backend/server.js" },
    { "src": "/support\\.html",    "dest": "backend/server.js" },
    { "src": "/documentation\\.html", "dest": "backend/server.js" },
    { "src": "/landing\\.html",    "dest": "backend/server.js" },
    { "src": "/css/(.*)",          "dest": "frontend/css/$1" },
    { "src": "/js/(.*)",           "dest": "frontend/js/$1" },
    { "src": "/(.*\\.(ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|eot))", "dest": "frontend/$1" },
    { "src": "/(.*)",              "dest": "backend/server.js" }
  ]
}
