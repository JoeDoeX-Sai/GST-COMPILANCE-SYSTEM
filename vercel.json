{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)",          "dest": "backend/server.js" },
    { "src": "/socket.io/(.*)",    "dest": "backend/server.js" },
    { "src": "/api-docs(.*)",      "dest": "backend/server.js" },
    { "src": "/css/(.*)",          "dest": "frontend/css/$1" },
    { "src": "/js/(.*)",           "dest": "frontend/js/$1" },
    { "src": "/(.*\\.(ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|eot))", "dest": "frontend/$1" },
    { "src": "/index\\.html",      "dest": "frontend/index.html" },
    { "src": "/landing\\.html",    "dest": "frontend/landing.html" },
    { "src": "/profile\\.html",    "dest": "frontend/profile.html" },
    { "src": "/contact\\.html",    "dest": "frontend/contact.html" },
    { "src": "/privacy\\.html",    "dest": "frontend/privacy.html" },
    { "src": "/terms\\.html",      "dest": "frontend/terms.html" },
    { "src": "/support\\.html",    "dest": "frontend/support.html" },
    { "src": "/documentation\\.html", "dest": "frontend/documentation.html" },
    { "src": "/demo-3d\\.html",    "dest": "frontend/demo-3d.html" },
    { "src": "/app\\.html",        "dest": "frontend/app.html" }
  ]
}
